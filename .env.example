# =============================================================================
# Environment Configuration — Safe Development Defaults
# =============================================================================
# Copy this file to .env and adjust for your environment.
# Never commit .env with real credentials to version control.
# =============================================================================

# PostgreSQL
POSTGRES_USER=food_user
POSTGRES_PASSWORD=food_pass
POSTGRES_DB=food_ordering

# Kafka (internal Docker DNS names used by services)
KAFKA_BOOTSTRAP_SERVERS=kafka1:9092,kafka2:9092,kafka3:9092

# Confluent Schema Registry
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# Service log levels
LOG_LEVEL=INFO

# Outbox publisher polling interval (seconds)
OUTBOX_POLL_INTERVAL_SECONDS=5

# Outbox publisher max retry attempts
OUTBOX_MAX_RETRY_ATTEMPTS=5

# Kafka consumer group IDs
ORDER_SERVICE_CONSUMER_GROUP=order-service-group
PAYMENT_SERVICE_CONSUMER_GROUP=payment-service-group
RESTAURANT_SERVICE_CONSUMER_GROUP=restaurant-service-group
CUSTOMER_SERVICE_CONSUMER_GROUP=customer-service-group

# Kafka topics
TOPIC_PAYMENT_REQUEST=payment-request
TOPIC_PAYMENT_RESPONSE=payment-response
TOPIC_RESTAURANT_APPROVAL_REQUEST=restaurant-approval-request
TOPIC_RESTAURANT_APPROVAL_RESPONSE=restaurant-approval-response
TOPIC_CUSTOMER=customer

# Debezium / CDC mode (polling | cdc)
OUTBOX_PUBLISHER_MODE=polling
